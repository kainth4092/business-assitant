# ==============================================================================
# Environment Configuration for Business Assistant
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini API Configuration
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# LLM model for routing, tool calling, answer synthesis, and groundedness checking
LLM_MODEL=gemini-1.5-flash

# Embeddings model for document ingestion and semantic vector retrieval (768 dimensions)
EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------------------------------------------
# PostgreSQL & pgvector Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=business_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# Standard Read/Write Database Connection String (used by backend & migration scripts)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5434/business_assistant

# Dedicated Read-Only User Connection String (used strictly by MCP SQL query tool)
READONLY_DATABASE_URL=postgresql://sales_readonly:readonly_password@localhost:5434/business_assistant

# ------------------------------------------------------------------------------
# Backend & API Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# System & Path Configurations
# ------------------------------------------------------------------------------
DATA_DIR=./data
DOCS_DIR=./docs
